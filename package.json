{
  "name": "tgxray",
  "version": "0.1.0",
  "description": "Desktop Telegram Web client routed through Xray (VLESS/Reality)",
  "main": "out/main/index.js",
  "author": {
    "name": "tgxray",
    "email": "tgxray@example.com"
  },
  "license": "MIT",
  "xrayVersion": "1.8.24",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch-xray": "tsx scripts/fetch-xray.ts",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.json",
    "dist:win:portable": "electron-vite build && electron-builder --win portable --config electron-builder.json",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.json",
    "dist:linux": "electron-vite build && electron-builder --linux --config electron-builder.json"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "socks-proxy-agent": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "homepage": "https://github.com/local/tgxray"
}
